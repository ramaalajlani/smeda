# =========================================================
# PHP / Laravel caches
# =========================================================

**/.phpunit.cache/
**/.phpunit.result.cache
**/.phpunit.cache

**/bootstrap/cache/*.php
!**/bootstrap/cache/.gitignore


# =========================================================
# Dependencies
# تجاهل vendor و node_modules في الجذر وأي مجلد داخلي
# =========================================================

**/vendor/
**/node_modules/


# =========================================================
# Environment files and secrets
# =========================================================

**/.env
**/.env.*
!**/.env.example

**/auth.json
**/*.key


# =========================================================
# Laravel public generated files
# =========================================================

**/public/build/
**/public/hot
**/public/storage/


# =========================================================
# Laravel storage generated files
# =========================================================

**/storage/*.key
**/storage/pail/

**/storage/logs/*
!**/storage/logs/.gitignore

**/storage/framework/cache/data/*
!**/storage/framework/cache/data/.gitignore

**/storage/framework/sessions/*
!**/storage/framework/sessions/.gitignore

**/storage/framework/testing/*
!**/storage/framework/testing/.gitignore

**/storage/framework/views/*
!**/storage/framework/views/.gitignore


# =========================================================
# Deployment and hosting files
# =========================================================

**/deploy/hostinger/dist/
**/deploy/hostinger/env.production


# =========================================================
# Databases and backups
# =========================================================

**/*.sql
**/*.sqlite
**/*.sqlite3
**/*.db

**/backup_before_import.sql
**/*.backup
**/*.bak


# =========================================================
# Logs and temporary files
# =========================================================

**/*.log
**/npm-debug.log
**/yarn-debug.log
**/yarn-error.log
**/pnpm-debug.log

**/debug_out.txt
**/extract_log.txt

**/nul
**/*.tmp
**/*.temp
**/*.cache


# =========================================================
# IDE and editor settings
# =========================================================

**/.fleet/
**/.idea/
**/.vscode/
**/.cursor/


# =========================================================
# Operating system files
# =========================================================

**/.DS_Store
**/Thumbs.db
**/Desktop.ini


# =========================================================
# Laravel Homestead
# =========================================================

**/Homestead.json
**/Homestead.yaml