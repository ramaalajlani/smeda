APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8080

# Local dev: double-click dev-start.bat (Windows) or run:
#   php artisan serve
#   php -S 127.0.0.1:8080 -t front front/router.php

# Production example:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.smeda.gov.sy
# FRONTEND_URL=https://smeda.gov.sy

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=authority4
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_DRIVER=database and SESSION_DOMAIN=.smeda.gov.sy

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
# Production: SANCTUM_STATEFUL_DOMAINS=smeda.gov.sy,www.smeda.gov.sy
# Must match FRONTEND_URL host(s) when using Sanctum cookie auth.

CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8000,http://localhost:8000
# Production: CORS_ALLOWED_ORIGINS=https://smeda.gov.sy

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# Production: CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum token lifetime in minutes (480 = 8 hours). Set empty to disable expiration.
# Production: prefer httpOnly session cookies (see SANCTUM_STATEFUL_DOMAINS) over long-lived tokens.
SANCTUM_TOKEN_EXPIRATION=480

# Legacy data import (optional)
OLD_AUTHORITY3_DB_DATABASE=old_authority3
OLD_ENTREP_DB_DATABASE=old_entrep

# Need classification microservice (floating AI button)
# AI_CLASSIFY_URL=http://127.0.0.1:9000/classify
# AI_CLASSIFY_TOKEN=
# AI_CLASSIFY_METHOD=POST
# AI_CLASSIFY_TIMEOUT=20

# --- Production (copy to .env on server; never commit .env) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://smeda.gov.sy/api
# FRONTEND_URL=https://smeda.gov.sy
# CORS_ALLOWED_ORIGINS=https://smeda.gov.sy
# SANCTUM_STATEFUL_DOMAINS=smeda.gov.sy,www.smeda.gov.sy
# SESSION_DOMAIN=.smeda.gov.sy
# Run migrations only: php artisan migrate --force
# Do NOT run: php artisan db:seed or DatabaseSeeder on production
